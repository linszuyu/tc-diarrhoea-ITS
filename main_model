# ==============================================================================
# Interrupted Time Series (ITS) Analysis
# Estimating excess cases during extreme weather events
#
# Model: Quasi-Poisson GLM with natural splines for time trend and covariates
# Outcome: Excess cases during the event window

# ==============================================================================

suppressPackageStartupMessages({
  library(dplyr)
  library(splines)
  library(tibble)
})

# ==============================================================================
# SETTINGS
# ==============================================================================

# Directory containing per-event RDS files (one file per event)
# Each RDS should be a data frame with columns:
#   yrwk, relative_week, cases, t2m, tp, time
in_dir <- "data/main_df_analysis"

# Event window: relative weeks counted as the "exposed" period
EVENT_WINDOW   <- 0:2

# Minimum data requirements
MIN_PRE_WEEKS  <- 12L
MIN_POST_WEEKS <- 3L

# ITS model formula
# event     = binary indicator (1 = event window, 0 = pre-period)
# time      = sequential week index (captures long-term trend)
# t2m       = mean temperature (°C)
# tp        = total precipitation (mm)
fml_global <- as.formula(paste(
  "cases ~ event + ns(time, df = 5)",
  "+ ns(t2m, knots = quantile(t2m, c(0.25, 0.75), na.rm = TRUE))",
  "+ ns(tp,  knots = quantile(tp,  c(0.25, 0.75), na.rm = TRUE))"
))

# ==============================================================================
# ITS ANALYSIS LOOP
# ==============================================================================
rds_files <- list.files(in_dir, pattern = "\\.rds$", full.names = TRUE)
if (!length(rds_files)) stop("No RDS files found in: ", in_dir)

results <- list()

for (f in rds_files) {
  event_name <- tools::file_path_sans_ext(basename(f))
  message("Processing: ", event_name)

  dat <- tryCatch(readRDS(f), error = function(e) NULL)
  if (is.null(dat)) next

  # Prepare dataset
  df_e <- dat %>%
    arrange(yrwk) %>%
    mutate(
      is_zero  = !is.na(relative_week) & relative_week == 0L,
      event_id = cumsum(ifelse(is_zero, 1L, 0L)),
      time     = if ("time" %in% names(.)) time else row_number(),
      in_event = (event_id == 1L) & !is.na(relative_week) &
                 (relative_week %in% EVENT_WINDOW),
      event    = as.integer(in_event)
    )

  # Data sufficiency check
  n_pre  <- sum(!is.na(df_e$cases[df_e$relative_week <  0L]))
  n_post <- sum(!is.na(df_e$cases[df_e$relative_week >= 0L]))
  if (n_pre < MIN_PRE_WEEKS || n_post < MIN_POST_WEEKS) {
    message("  SKIP: insufficient data (pre=", n_pre, ", post=", n_post, ")")
    next
  }

  # Covariate fallback if missing
  if (!"t2m" %in% names(df_e)) df_e$t2m <- 0
  if (!"tp"  %in% names(df_e)) df_e$tp  <- 0

  # Fit quasi-Poisson ITS model
  fit <- tryCatch(
    glm(fml_global, family = quasipoisson, data = df_e, na.action = na.exclude),
    error = function(e) NULL
  )
  if (is.null(fit)) { message("  SKIP: model failed"); next }

  # Counterfactual: what would cases have been without the event?
  p0 <- predict(fit, type = "link",
                newdata = transform(df_e, event = 0L), se.fit = TRUE)

  df_e <- df_e %>%
    mutate(
      pred_cf       = exp(p0$fit),
      pred_cf_lower = exp(p0$fit - 1.96 * p0$se.fit),
      pred_cf_upper = exp(p0$fit + 1.96 * p0$se.fit)
    )

  # Excess cases = observed - counterfactual, summed over event window
  ev <- df_e %>% filter(in_event)
  if (nrow(ev) == 0L) next

  excess_est  <- sum(ev$cases, na.rm = TRUE) - sum(ev$pred_cf,       na.rm = TRUE)
  excess_low  <- sum(ev$cases, na.rm = TRUE) - sum(ev$pred_cf_upper,  na.rm = TRUE)
  excess_high <- sum(ev$cases, na.rm = TRUE) - sum(ev$pred_cf_lower,  na.rm = TRUE)

  results[[event_name]] <- tibble(
    event       = event_name,
    excess_est  = round(excess_est),
    excess_low  = round(excess_low),
    excess_high = round(excess_high)
  )

  message("  Excess: ", round(excess_est),
          " (95% CI: ", round(excess_low), ", ", round(excess_high), ")")
}

# ==============================================================================
# RESULTS
# ==============================================================================
results_df <- bind_rows(results)
print(results_df)
